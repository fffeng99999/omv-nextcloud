#!/usr/bin/make -f

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

%:
	dh $@

# Windows checkouts do not preserve the executable bit; force the
# correct modes on the shipped scripts before packaging.
execute_before_dh_installdeb:
	chmod 0755 debian/openmediavault-nextcloud.postinst
	chmod 0755 debian/openmediavault-nextcloud.prerm
	chmod 0755 debian/openmediavault-nextcloud.postrm
	chmod 0755 debian/openmediavault-nextcloud/usr/sbin/omv-nextcloud-ctl || true
	chmod 0755 debian/openmediavault-nextcloud/usr/share/openmediavault/confdb/create.d/*.sh
