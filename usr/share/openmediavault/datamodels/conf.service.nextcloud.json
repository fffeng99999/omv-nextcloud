{
	"type": "config",
	"id": "conf.service.nextcloud",
	"title": "Nextcloud",
	"queryinfo": {
		"xpath": ".//services/nextcloud",
		"iterable": false
	},
	"properties": {
		"enable": {
			"type": "boolean",
			"default": false
		},
		"version": {
			"type": "string",
			"default": "34.0.4-apache"
		},
		"port": {
			"type": "integer",
			"minimum": 1,
			"maximum": 65535,
			"default": 8080
		},
		"timeZone": {
			"type": "string",
			"default": "Etc/UTC"
		},
		"dataRef": {
			"type": "string",
			"oneOf": [{
				"type": "string",
				"format": "uuidv4"
			}, {
				"type": "string",
				"maxLength": 0
			}],
			"default": ""
		},
		"dbRef": {
			"type": "string",
			"oneOf": [{
				"type": "string",
				"format": "uuidv4"
			}, {
				"type": "string",
				"maxLength": 0
			}],
			"default": ""
		},
		"dbPassword": {
			"type": "string",
			"default": ""
		},
		"dbUsername": {
			"type": "string",
			"default": "nextcloud"
		},
		"dbDatabaseName": {
			"type": "string",
			"default": "nextcloud"
		},
		"adminUser": {
			"type": "string",
			"default": "admin"
		},
		"adminPassword": {
			"type": "string",
			"default": ""
		},
		"trustedDomains": {
			"type": "string",
			"default": ""
		}
	}
}
